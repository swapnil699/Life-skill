     function onVernacularFormDataHandler(response) { 
      debugger; 
      var reports = JSON.parse(response); 
   var report=reports.fileName; 
   if(report.includes("/")){ 
      report= report.split("/"); 
   } 
   else if(report.includes("\\")){ 
   report= report.split("\\"); 
   } 
   var pathfolder = report[0]; 
   var pathfileName = report[1]; 
   var loginId = getRequestParamObject().accessCode; 
   // location.href = "DisplayImage?reports="+reports.reportId+"&reportName="+pathfolder +"/" + pathfileName ; 
   /* location.href = "DisplayImage?reports=" +reports.reportId +"&accessCode="+getRequestParamObject().accessCode + "&reportName="+pathfolder +"/" + pathfileName ; */ 

   $.ajax({ 
   url:projectName + "/DisplayImage1", 
   xhrFields: { 
   responseType: "blob", 
   }, 
   type: "post", 
   data: { 
      reports : reports.reportId, 
      reportName : pathfolder +"/" + pathfileName, 
      accessCode : loginId 
   },   
   success: function(data) { 
      debugger; 
   var link=document.createElement('a'); 
