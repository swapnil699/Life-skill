    function validation() { 
      var stringStr = ""; 

      if ($("#dropDown_DocumentType").data("kendoDropDownList").value() == "") { 
        stringStr += "Document Type is mandatory.\n"; 
      } 
      if ($("#dropDown_Group").data("kendoDropDownList").value() == "") { 
        stringStr += "Group is mandatory.\n"; 
      } 

      if (stringStr.length > 1) { 
        alert(stringStr); 
        return false; 
      } else { 
        return true; 
      } 
    } 

