          var proposedDate = kendo.toString(proposedDisbursedDate,"yyyy-MM-dd"); 

          if(proposedDate == null){ 
            proposedDate =kendo.toString(new Date(), "yyyy-MM-dd"); 
          } 
          requestParam.jsonFilterText = "{\"groupId\":\"" +aesEncryption($("#dropDown_Group").data("kendoDropDownList").value())+ "\",\"proposedDisbursementDate\":\"" + aesEncryption(proposedDate) + "\",\"hospicashVendorId\":\"" + aesEncryption($("#dropDown_DocumentType").data("kendoDropDownList").value()) + "\"}"; 

          getDataFromServer(projectName + "/rest/loan_product_enrollment/get_hospicash_vendor_loan_documents_data", 
              getRequestParamString(requestParam), "POST", 
              onLoanApplicationsReceiveHandler, errorHandler); 
