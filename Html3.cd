            requestParam.jsonFilterText = "{\"groupId\":\"" +aesEncryption($("#dropDown_Group").data("kendoDropDownList").value())+ "\",\"proposedDisbursementDate\":\"" + aesEncryption(proposedDate) + "\"}"; 

            getDataFromServer(projectName + "/rest/loan_product_enrollment/get_loan_Documents_data", 
