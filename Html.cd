  <!--   select hm.hierarchy_name,center_name,cem.center_id,group_name,gm.group_id,customer_name, 
  style="margin-left: 10px; margin-right: 10px; margin-bottom: 20px;" 
customer_number,loan_number,loan_amount from customer_master cm 
RIGHT JOIN loan_applications la ON la.customer_id = cm.customer_id and la.delete_flag=0 
RIGHT JOIN hierarchy_master hm ON hm.hierarchy_id = cm.branch_id and hm.delete_flag=0 
RIGHT JOIN group_master gm ON gm.branch_id = hm.hierarchy_id and gm.delete_flag=0 
RIGHT JOIN center_master cem ON cem.center_id = gm.center_id and cem.delete_flag=0 
RIGHT JOIN service_point_master spm ON spm.service_point_id = cem.service_point_id and spm.delete_flag=0 
where hm.hierarchy_id='193' and gm.group_name='ASHA' --> 

  <!-- select gm.group_name,gm.group_id,gm.branch_id from group_master gm,hierarchy_master hm where hm.hierarchy_id=gm.branch_id and hm.delete_flag=0 
and gm.proposed_disbursement_date = '2018-03-23' and hm.hierarchy_id=193   --> 
